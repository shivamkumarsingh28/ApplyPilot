# Copy this file to .env, or run `make setup` to create .env with random secrets.
# Lines starting with # are comments.

# ---------- Core ----------
# use "production" when you deploy (it makes ENCRYPTION_KEY required)
APP_ENV=development
# signs login tokens. Long and random.
SECRET_KEY=change-me
# encrypts files and profiles. `make setup` creates one for you.
ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./data/applypilot.db
STORAGE_DIR=./data/files
CORS_ORIGINS=http://localhost:3000
# comma-separated emails that become admins when they register
ADMIN_EMAILS=

# ---------- Which AI model to use ----------
# meta          Meta Model API (Muse Spark). DEFAULT - use this for development, testing and production.
# llama_local   OPTIONAL backup only: a Meta Llama model on your own computer through Ollama. Free.
# mock          no model at all. Works offline, good for a first look and for tests.
# openai_compat any OpenAI-style server (OpenAI, Baseten, Fireworks, Modal, vLLM)
# If LLM_PROVIDER=meta but META_API_KEY is empty, the app falls back to mock with a warning.
LLM_PROVIDER=meta

# meta settings (default)
META_API_KEY=
META_API_BASE=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# llama_local settings - optional backup (run `ollama pull llama3.1` first)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
# optional, for scanned notices, e.g. llama3.2-vision
OLLAMA_VISION_MODEL=

# openai_compat settings
OPENAI_COMPAT_BASE=
OPENAI_COMPAT_KEY=
OPENAI_COMPAT_MODEL=

# Embeddings: Meta Model API has NO embeddings endpoint, so embeddings use a
# SEPARATE embedding model on an OpenAI-compatible endpoint. api + EMBEDDING_MODEL
# set = neural embeddings; empty = built-in offline hash vectors.
EMBEDDING_PROVIDER=api
# e.g. a hosted multilingual embedder, or Ollama: EMBEDDING_BASE=http://localhost:11434/v1 EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# opencv = built-in background removal. meta_sam = SAM 3.1 through an HTTP endpoint you set up.
SEGMENTER=opencv
SAM_ENDPOINT=
SAM_API_KEY=

# ---------- Limits ----------
RATE_LIMIT_PER_MINUTE=60
AI_RATE_LIMIT_PER_MINUTE=12
LOGIN_RATE_LIMIT_PER_MINUTE=8

# ---------- Chat bot ----------
BOT_SHARED_SECRET=change-me-bot-secret
# telegram or whatsapp
BOT_TRANSPORT=telegram
# from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
BACKEND_URL=http://localhost:8000
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---------- Phase 2 ----------
# vault quotas
VAULT_MAX_FILE_MB=5
VAULT_MAX_TOTAL_MB=50
# OAuth login (leave blank to disable a provider). Redirect: <OAUTH_REDIRECT_BASE>/api/v1/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000
# web search: brave | tavily (Google Custom Search is NOT supported - it shuts down 2027-01-01)
SEARCH_PROVIDER=
BRAVE_API_KEY=
TAVILY_API_KEY=
SEARCH_ALLOWED_DOMAINS=gov.in,nic.in,ssc.gov.in,upsc.gov.in,ibps.in

# ---------- Docker only ----------
POSTGRES_PASSWORD=change-me-db-password
# the address the BROWSER uses to reach the backend
PUBLIC_API_URL=http://localhost:8000/api/v1
