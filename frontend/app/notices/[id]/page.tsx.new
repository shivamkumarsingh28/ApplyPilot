"use client";
import Link from "next/link";
import { useParams, useRouter } from "next/navigation";
import { useEffect, useState } from "react";
import AuthGate from "@/components/AuthGate";
import { Badge, Card, ErrorText, Skeleton, StatusChip, fmtDate } from "@/components/ui";
import { api } from "@/lib/api";
import type { Answer, Eligibility, Notice, Readiness } from "@/lib/types";

const TABS = ["Overview", "Eligibility", "Ask", "Documents", "Safety"] as const;
const VERDICT = { eligible: "You look eligible", not_eligible: "You may not be eligible", needs_info: "Add details to check eligibility" } as const;

function Fact({ label, value, page }: { label: string; value: string; page?: number }) {
  return (
    <div style={{ border: "1px solid var(--line)", borderRadius: 10, padding: 12 }}>
      <div className="muted small">{label}</div>
      <div><strong>{value}</strong></div>
      {page ? <div><Badge tone="info">Page {page}</Badge> <span className="muted small">Found in notice</span></div> : <div className="muted small">Please check in the notice</div>}
    </div>
  );
}

function NoticeDetail() {
  const { id } = useParams<{ id: string }>();
  const router = useRouter();
  const [tab, setTab] = useState<(typeof TABS)[number]>("Overview");
  const [notice, setNotice] = useState<Notice | null>(null);
  const [elig, setElig] = useState<Eligibility | null>(null);
  const [ready, setReady] = useState<Readiness | null>(null);
  const [chat, setChat] = useState<{ q: string; a: Answer }[]>([]);
  const [question, setQuestion] = useState("");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const loadAll = () => {
    api.get<Notice>(`/notices/${id}`).then(setNotice).catch((e) => setError(e.message));
    api.get<Eligibility>(`/notices/${id}/eligibility`).then(setElig).catch(() => {});
    api.get<Readiness>(`/notices/${id}/readiness`).then(setReady).catch(() => {});
  };
  useEffect(loadAll, [id]);

  async function ask(e: React.FormEvent) {
    e.preventDefault();
    const q = question.trim();
    if (!q) return;
    setBusy(true); setQuestion("");
    try {
      const a = await api.post<Answer>(`/notices/${id}/ask`, { question: q });
      setChat((c) => [...c, { q, a }]);
    } catch (err) { setError(err instanceof Error ? err.message : "Could not answer"); } finally { setBusy(false); }
  }

  if (!notice) return error ? <ErrorText error={error} /> : <Skeleton lines={5} />;
  const s = notice.structured;
  const scam = notice.scam_report;
  const ev = s.evidence ?? {};
  const missingField = elig?.missing_profile_fields?.[0];

  return (
    <>
      <p><Link href="/notices">← Notices</Link></p>
      <h1>{notice.title}</h1>
      <p>
        <StatusChip status={scam.level} /> <StatusChip status={notice.trust} />
        {notice.shared && <Badge tone="info">Shared — you got it instantly</Badge>}
        <span className="muted"> Last date {fmtDate(s.last_date)}</span>
      </p>
      {notice.apply_link ? (
        <p><a className="btn" href={notice.apply_link} target="_blank" rel="noopener noreferrer">Apply on the official website</a></p>
      ) : <p className="muted small">No official apply link was found in this notice. Open the official site from the notice text.</p>}

      <div className="tabs" role="tablist" aria-label="Notice sections">
        {TABS.map((t) => <button key={t} type="button" role="tab" aria-selected={tab === t} className={tab === t ? "active" : ""} onClick={() => setTab(t)}>{t}</button>)}
      </div>

      {tab === "Overview" && (
        <>
          <div className="grid2">
            <Fact label="Who can apply (age)" value={`${s.age.min ?? "?"} to ${s.age.max ?? "?"} years${s.age.as_of ? `, as on ${fmtDate(s.age.as_of)}` : ""}`} page={ev.age?.page} />
            <Fact label="Qualification" value={`${s.qualification.level?.replace(/_/g, " ") ?? "Not found"}${s.qualification.min_percentage ? `, min ${s.qualification.min_percentage}%` : ""}`} page={ev.qualification?.page} />
            <Fact label="Last date" value={fmtDate(s.last_date)} page={ev.last_date?.page} />
            {s.start_date && <Fact label="Start date" value={fmtDate(s.start_date)} page={ev.start_date?.page} />}
            <Fact label="Fee" value={s.fee ? `${s.fee.currency} ${s.fee.amount}` : "Not found"} />
            {s.vacancies ? <Fact label="Vacancies / posts" value={String(s.vacancies)} /> : null}
            {s.salary?.amount ? <Fact label="Salary / stipend" value={`${s.salary.currency} ${s.salary.amount}`} /> : null}
            <Fact label="Selection" value={s.selection_stages.join(" → ") || "Not found"} />
          </div>
          <Card title="Age relaxation">
            <p>{Object.entries(s.age.relaxations).map(([k, v]) => `${k.toUpperCase()} +${v} years`).join(" · ") || "None found in the notice."}</p>
            {s.needs_review.length > 0 && <p className="muted small">Please check these against the original: {s.needs_review.map((r) => r.field).join(", ")}</p>}
            <p className="muted small">Read by: {s.method}. Always confirm with the official notice.</p>
          </Card>
        </>
      )}

      {tab === "Eligibility" && (
        <Card title="Am I eligible?">
          {!elig ? <Skeleton lines={3} /> : (
            <>
              <p><StatusChip status={elig.verdict} /> <strong>{VERDICT[elig.verdict]}</strong></p>
              {missingField && (
                <p className="badge warn" style={{ display: "block", padding: 12 }}>
                  To finish this check, add your {missingField.replace(/_/g, " ")}. It stays private.{" "}
                  <Link href="/profile">Add it now</Link> — then come back and this re-runs.
                </p>
              )}
              <ul className="plain">
                {elig.checks.map((c) => (
                  <li key={c.rule}><strong>{c.rule}</strong> <Badge tone={c.status === "pass" ? "good" : c.status === "fail" ? "bad" : "warn"}>{c.status}</Badge><br /><span className="muted small">{c.detail}</span></li>
                ))}
              </ul>
              <p><button type="button" className="secondary" onClick={loadAll}>Re-check</button></p>
              <p className="muted small">{elig.disclaimer}</p>
            </>
          )}
        </Card>
      )}

      {tab === "Ask" && (
        <Card title="Ask this notice">
          <div className="chat">
            {chat.map((m, i) => (
              <div key={i}>
                <div className="msg me">{m.q}</div>
                <div className="msg">{m.a.answer?.trim() ? m.a.answer : "The model returned an empty answer. Please ask again."}</div>
                {m.a.citations.length > 0 && <p className="muted small">From page{m.a.citations.length > 1 ? "s" : ""} {[...new Set(m.a.citations.map((c) => c.page))].join(", ")}{m.a.verified ? " · ✓ checked against the notice text" : ""}{m.a.cached ? " · saved answer" : ""}</p>}
                {(m.a.verbatim ?? []).map((v, j) => (
                  <blockquote key={j} className="quote small">“{v.quote}” <span className="muted">— as written in the notice, page {v.page}</span></blockquote>
                ))}
              </div>
            ))}
          </div>
          <form className="row" onSubmit={ask}>
            <div><label htmlFor="q">Your question</label><input id="q" value={question} onChange={(e) => setQuestion(e.target.value)} placeholder="Is there a physical test? What is the fee?" /></div>
            <button disabled={busy || !question.trim()}>{busy ? "…" : "Ask"}</button>
          </form>
        </Card>
      )}

      {tab === "Documents" && (
        <Card title="Ready to apply?">
          {!ready ? <Skeleton lines={3} /> : (
            <>
              <div className="bar" aria-label={`${ready.percent}% ready`}><div style={{ width: `${ready.percent}%` }} /></div>
              <p>{ready.percent}% of documents ready{ready.days_left !== null ? `, ${ready.days_left} days left` : ""}</p>
              {ready.have.length > 0 && <><strong>Ready</strong><ul>{ready.have.map((m) => <li key={m.kind}>✓ {m.label}</li>)}</ul></>}
              {ready.missing.length > 0 && <><strong>Missing</strong><ul>{ready.missing.map((m) => <li key={m.kind}>{m.label}</li>)}</ul></>}
              <p>
                <Link className="btn" href={`/photo?notice=${notice.id}`}>Fix photo and signature</Link>{" "}
                <Link href="/vault">Open vault</Link>{" "}
                <button type="button" className="secondary" onClick={async () => { const blob = await api.blob(`/notices/${notice.id}/checklist`); window.open(URL.createObjectURL(blob), "_blank"); }}>Print checklist</button>
              </p>
            </>
          )}
        </Card>
      )}

      {tab === "Safety" && (
        <Card title="Is this notice safe?">
          <p><StatusChip status={scam.level} /> <span className="muted small">score {scam.score}/100</span></p>
          {scam.reasons.length ? <ul>{scam.reasons.map((r) => <li key={r}>{r}</li>)}</ul> : <p className="muted">No warning signs found.</p>}
          <p className="muted small">{scam.disclaimer}</p>
        </Card>
      )}

      <p><button type="button" className="danger" onClick={async () => { await api.del(`/notices/${id}`); router.push("/notices"); }}>Delete notice</button></p>
    </>
  );
}

export default function Page() {
  return <AuthGate><NoticeDetail /></AuthGate>;
}
